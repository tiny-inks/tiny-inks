# ============================================================================
# Tiny Inks — environment variables
# ----------------------------------------------------------------------------
# Every variable the application reads (checked against process.env usage in
# the code). What each one is and where it comes from: ENVIRONMENT_SETUP.md
#
# PLACEHOLDERS ONLY. Never put a real key, token, password or secret here.
#
# server-only   = read only on the server. NEVER rename to NEXT_PUBLIC_*.
# NEXT_PUBLIC_* = inlined into the browser bundle at build time: public, and a
#                 change needs a redeploy.
# Values are used VERBATIM: no quotes, no spaces, no trailing slash.
#
# Check a configuration without printing secrets:
#   vercel env run -e production -- node scripts/check-production-env.mjs
#   node scripts/check-production-env.mjs --file .env.local --env development
# ============================================================================

# ---- Mode -------------------------------------------------------------------
# Production: false (live Shopify catalogue). Local development without Shopify: true.
# Only the exact string "true" turns demo mode on.
NEXT_PUBLIC_DEMO_MODE=false

# ---- Shopify Storefront API — catalogue + server-side basket pricing --------
# Public. Bare hostname: no https://, no trailing slash.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=tiny-inks-stationery.myshopify.com
# Public. Storefront API public access token (Headless sales channel).
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Optional. YYYY-MM. Default 2026-01.
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-01

# ---- Shopify Admin API — order creation (Stripe webhook) + staff queue ------
# server-only. Credentials of the Dev Dashboard app "Tiny Inks Website Backend"
# (Dev Dashboard → the app → Settings), installed on the store below, in the
# same Shopify organization. Both values must come from that SAME app.
# Sent as client_id / client_secret to
#   https://<SHOPIFY_SHOP_DOMAIN>/admin/oauth/access_token
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# server-only. Bare hostname of the store: no https://, no slash, no /admin path.
SHOPIFY_SHOP_DOMAIN=tiny-inks-stationery.myshopify.com
# Optional. YYYY-MM. Default 2026-01.
SHOPIFY_ADMIN_API_VERSION=2026-01
# LEGACY — leave EMPTY with a Dev Dashboard app. When set, this static shpat_
# token is used INSTEAD of the client ID/secret (no token request is made).
SHOPIFY_ADMIN_TOKEN=
# (The code also reads SHOPIFY_STORE_DOMAIN as an older fallback name for
#  SHOPIFY_SHOP_DOMAIN. Do not set both.)

# ---- Stripe — on-site card checkout -----------------------------------------
# Public. pk_live_… in production. Same mode (live/test) as STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# server-only. sk_live_… in production.
STRIPE_SECRET_KEY=
# server-only. whsec_… signing secret of the endpoint
#   https://www.tinyinks.ae/api/stripe/webhook   (www — the apex redirects)
STRIPE_WEBHOOK_SECRET=
# Optional, server-only. https URL POSTed when a PAID order fails to reach Shopify.
CHECKOUT_ALERT_WEBHOOK=

# ---- Email — Resend -----------------------------------------------------------
# server-only. re_… Sends order confirmations, staff order notifications and the contact form.
RESEND_API_KEY=
# server-only. Sender for order mail, on a domain verified in Resend,
# e.g. Tiny Inks <orders@tinyinks.ae>. Falls back to CONTACT_FROM_EMAIL.
RESEND_FROM_EMAIL=
# server-only. Staff inbox for NEW ORDER notifications. Falls back to CONTACT_TO_EMAIL.
ORDER_NOTIFICATION_EMAIL=
# server-only. Inbox for the contact form (and fallback staff order recipient).
CONTACT_TO_EMAIL=
# server-only. Sender for the contact form (and fallback sender for order mail).
CONTACT_FROM_EMAIL=
# Optional, server-only. Formspree form id — only used when RESEND_API_KEY is empty.
FORMSPREE_FORM_ID=

# ---- Staff app, signed links, cron ---------------------------------------------
# server-only. REQUIRED in production — without it the staff app accepts the demo password.
STAFF_PASSWORD=
# server-only. REQUIRED in production — signs the staff session cookie and file links.
# At least 32 random characters, e.g. `openssl rand -hex 32`.
# (STAFF_SESSION_SECRET is an older fallback name. Do not set both.)
PRINT_SIGNING_SECRET=
# server-only. Authorises the daily cleanup cron (vercel.json → /api/print/cleanup).
CRON_SECRET=
# Optional, server-only. vercel_blob_rw_… Private storage for print uploads.
BLOB_READ_WRITE_TOKEN=
# Optional. Signed-link lifetime in hours / uploaded-file retention in days.
PRINT_LINK_TTL_HOURS=24
PRINT_FILE_RETENTION_DAYS=7

# ---- Site details (public) ---------------------------------------------------
# Canonical origin for canonical URLs, sitemap and robots. No path.
NEXT_PUBLIC_SITE_URL=https://www.tinyinks.ae
# Digits only, with country code (e.g. 9715XXXXXXXX). Unset = placeholder number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=hello@tinyinks.ae
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
# Optional overrides; each has a built-in default.
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_MAPS_URL=
NEXT_PUBLIC_SHOP_MAP_EMBED_URL=
NEXT_PUBLIC_SHOP_HOURS=
