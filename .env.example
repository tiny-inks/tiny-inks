# ---- Demo mode ----
# "true" = site runs on built-in sample products (no Shopify needed).
# Set to "false" once your Shopify keys below are filled in.
NEXT_PUBLIC_DEMO_MODE=true

# ---- Shopify (Storefront API) ----
# Store domain, e.g. tiny-inks.myshopify.com  (no https://)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Public Storefront API access token (from the Headless sales channel)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Storefront API version (update if Shopify sunsets this one)
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-01

# ---- Business details ----
NEXT_PUBLIC_WHATSAPP_NUMBER=971500000000
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/tinyinks
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@tinyinks
NEXT_PUBLIC_CONTACT_EMAIL=hello@tinyinks.ae
# Street address of the Abu Dhabi shop (shown on Contact + About; leave empty until final)
NEXT_PUBLIC_SHOP_ADDRESS=
# Optional: a Google Maps share link for the shop (otherwise a search link is built from the address)
NEXT_PUBLIC_SHOP_MAPS_URL=
# Optional: overrides the opening-hours text
NEXT_PUBLIC_SHOP_HOURS=

# ---- Contact form delivery (server-only, set in Vercel) ----
# Option A — Resend (https://resend.com): API key + the inbox that receives messages
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "Tiny Inks <hello@tinyinks.ae>"
CONTACT_FROM_EMAIL=
# Option B — Formspree form id (https://formspree.io), used when Resend is not set
FORMSPREE_FORM_ID=
# With neither set, the form tells the visitor to use WhatsApp/email instead (never a fake success).

# ---- Tiny Drops ----
# When the current drop closes / next drop lands (ISO date, Abu Dhabi time)
NEXT_PUBLIC_DROP_DATE=2026-09-01T18:00:00+04:00

# ---- Site URL (for SEO: sitemap, canonical, JSON-LD) ----
NEXT_PUBLIC_SITE_URL=https://tinyinks.ae

# ---- Print service ----
# Vercel Blob read/write token (Storage → Blob → connect to project). Without it uploads go to /tmp and the page warns.
BLOB_READ_WRITE_TOKEN=
# Secret for signed file links + staff session cookie (any long random string)
PRINT_SIGNING_SECRET=
# Signed link lifetime in hours (default 24) and file retention in days (default 7)
PRINT_LINK_TTL_HOURS=24
PRINT_FILE_RETENTION_DAYS=7
# Protects the daily cleanup cron (/api/print/cleanup) — Vercel sends it automatically as a Bearer token
CRON_SECRET=

# ---- Staff app (/staff) ----
# Shared password for the print desk PWA. Without it the demo password "tinyinks" is used and the login page warns.
STAFF_PASSWORD=
# Shopify Admin API access token (custom app with read_orders + write_orders) so the staff queue shows real orders
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_VERSION=2026-01
