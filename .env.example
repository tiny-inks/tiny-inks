# ============================================================================
# Tiny Inks — environment variables (.env.local for local dev, Vercel for prod)
# ----------------------------------------------------------------------------
# "server-only" = never exposed to the browser; NEVER rename those to NEXT_PUBLIC_*.
# Placeholders only — real keys never belong in this file.
# ============================================================================

# ---- Mode -------------------------------------------------------------------
# REQUIRED. "true" = built-in sample catalogue, no Shopify needed. "false" = live store.
NEXT_PUBLIC_DEMO_MODE=true

# ---- Shopify Storefront API (catalogue, cart) -------------------------------
# REQUIRED in live mode. Store domain without https://, e.g. tiny-inks.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# REQUIRED in live mode. Public Storefront access token (Headless sales channel).
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=shpsf_xxxxxxxxxxxxxxxx
# Optional. Storefront API version.
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-01

# ---- Shopify Admin API — client credentials grant (server-only) -------------
# Dev Dashboard app in the SAME Shopify organization as the store.
# Scopes: read_orders, write_orders (see checkout-report.md §3).
# REQUIRED for real orders (checkout + staff queue). server-only.
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# REQUIRED with the two above, e.g. tiny-inks.myshopify.com. server-only.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Optional. Admin API version.
SHOPIFY_ADMIN_API_VERSION=2026-01
# Optional legacy fallback: a static Admin token, if you still have one. server-only.
SHOPIFY_ADMIN_TOKEN=

# ---- Stripe — on-site checkout (start in TEST mode) -------------------------
# REQUIRED for card / Apple Pay / Google Pay. Publishable key is browser-safe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
# REQUIRED for card payments. server-only.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# REQUIRED for order creation — signing secret of the /api/stripe/webhook endpoint. server-only.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Optional. URL pinged when a PAID order fails to reach Shopify (Slack/Discord webhook). server-only.
CHECKOUT_ALERT_WEBHOOK=

# ---- Print module (/print uploads) ------------------------------------------
# REQUIRED for real use — private file storage on Vercel Blob; without it uploads
# go to /tmp and the page shows a warning. server-only.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
# REQUIRED in production — signs file links and the staff session cookie (any long
# random string, e.g. `openssl rand -hex 32`). server-only.
PRINT_SIGNING_SECRET=change-me-long-random-string
# Optional. Signed-link lifetime in hours (default 24) / file retention in days (default 7).
PRINT_LINK_TTL_HOURS=24
PRINT_FILE_RETENTION_DAYS=7
# REQUIRED in production — authorises the daily cleanup cron (Vercel sends it as a
# Bearer token to /api/print/cleanup). server-only.
CRON_SECRET=change-me-too

# ---- Staff app (/staff PWA) --------------------------------------------------
# REQUIRED in production — shared sign-in for the print desk. Without it the demo
# password "tinyinks" works and the login page warns. server-only.
STAFF_PASSWORD=change-me-shared-password

# ---- Contact form + newsletter -----------------------------------------------
# Pick ONE delivery path (both empty = the form honestly offers WhatsApp/email instead).
# Option A: Resend (https://resend.com). server-only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=orders@tinyinks.ae
# Optional verified sender for Resend, e.g. "Tiny Inks <hello@tinyinks.ae>". server-only.
CONTACT_FROM_EMAIL=
# Option B: Formspree form id (https://formspree.io). server-only.
FORMSPREE_FORM_ID=

# ---- Shop details (shown on the site — browser-safe) -------------------------
# REQUIRED. WhatsApp number, digits only with country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=971500000000
# Optional but recommended.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/tinyinks
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@tinyinks
NEXT_PUBLIC_CONTACT_EMAIL=hello@tinyinks.ae
# Street address of the Abu Dhabi shop (Contact + About show a fallback until set).
NEXT_PUBLIC_SHOP_ADDRESS=
# Optional. Google Maps share link (otherwise a search link is built from the address).
NEXT_PUBLIC_SHOP_MAPS_URL=
# Optional. Overrides the opening-hours text.
NEXT_PUBLIC_SHOP_HOURS=

# ---- SEO ---------------------------------------------------------------------
# REQUIRED in production. Canonical site URL for sitemap/robots/JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tinyinks.ae
